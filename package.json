{
  "name": "m3-expressive",
  "version": "0.2.1",
  "packageManager": "bun@1.4.0",
  "description": "Material 3 Expressive for React — showcase/docs app for the m3-expressive-react component library",
  "license": "MIT",
  "author": "Medianeth",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "build:package": "cd packages/m3-expressive-react && bun run build",
    "vr:baseline": "bun scripts/vr-capture.ts",
    "vr:check": "bun scripts/vr-compare.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@material/material-color-utilities": "^0.4.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.2",
    "next": "^16.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@next/eslint-plugin-next": "^16.1.1",
    "@tailwindcss/cli": "4.1.18",
    "@tailwindcss/postcss": "^4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "agent-browser": "0.35.1",
    "eslint": "^9",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "typescript-eslint": "^8.10.0"
  }
}
