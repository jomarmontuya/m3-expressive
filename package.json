{
  "name": "m3-expressive",
  "version": "0.1.0-beta.1",
  "packageManager": "bun@1.4.0",
  "description": "Material 3 Expressive React components distributed through a GitHub-hosted shadcn registry",
  "license": "MIT",
  "author": "Medianeth",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && bun scripts/prepare-standalone.ts",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "registry:build": "bun scripts/build-registry.ts",
    "registry:check": "bun scripts/registry-check.ts",
    "registry:validate": "shadcn registry validate ./registry.json",
    "registry:smoke": "bun scripts/registry-smoke.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@material/material-color-utilities": "^0.4.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.2",
    "next": "^16.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@next/eslint-plugin-next": "^16.1.1",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.0",
    "@types/react": "^19",
    "eslint": "^9",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "shadcn": "4.19.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "typescript-eslint": "^8.10.0"
  }
}
