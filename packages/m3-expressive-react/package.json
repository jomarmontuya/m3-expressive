{
  "name": "m3-expressive-react",
  "version": "1.0.0",
  "description": "Material 3 Expressive React component library — 40 spec-audited components, design tokens, spring motion, agentic-compatible metadata",
  "type": "module",
  "license": "MIT",
  "sideEffects": ["**/*.css"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./compiled.css": "./dist/compiled.css",
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js",
      "require": "./dist/tokens.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./meta": {
      "types": "./dist/meta.d.ts",
      "import": "./dist/meta.js",
      "require": "./dist/meta.cjs"
    },
    "./themes": {
      "types": "./dist/themes.d.ts",
      "import": "./dist/themes.js",
      "require": "./dist/themes.cjs"
    },
    "./theme-builder": {
      "types": "./dist/theme-builder.d.ts",
      "import": "./dist/theme-builder.js",
      "require": "./dist/theme-builder.cjs"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js",
      "require": "./dist/registry.cjs"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js",
      "require": "./dist/hooks.cjs"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup && node scripts/patch-client-directive.mjs && cp styles-src/m3-tokens.css dist/styles.css && bunx @tailwindcss/cli -i compiled-src/entry.css -o dist/compiled.css --minify",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "framer-motion": ">=11 <13"
  },
  "devDependencies": {
    "@types/react": "^19",
    "tsup": "^8.5.0",
    "typescript": "^5"
  }
}
