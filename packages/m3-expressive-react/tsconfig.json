{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../../src/*"]
    }
  },
  "include": [
    "../../src/components/m3/**/*.ts",
    "../../src/components/m3/**/*.tsx",
    "../../src/lib/m3/**/*.ts",
    "../../src/hooks/**/*.ts",
    "tsup.config.ts"
  ]
}
