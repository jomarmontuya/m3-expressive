{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "m3-expressive",
  "account_id": "f77b61dea90b9e6877061187376aa5e5",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "m3-expressive.medianeth.dev",
      "zone_name": "medianeth.dev",
      "custom_domain": true
    }
  ]
}
